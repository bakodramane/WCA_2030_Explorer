{
  "name": "wca-2030-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "ingest": "npx tsx scripts/chunk.ts",
    "embed": "npx tsx scripts/embed.ts",
    "build-items": "npx tsx scripts/build-items.ts",
    "build-glossary": "npx tsx scripts/build-glossary.ts",
    "build-figures": "npx tsx scripts/build-figures.ts",
    "build-qa": "npx tsx scripts/build-qa.ts",
    "validate": "npx tsx scripts/validate-data.ts",
    "repair-qa": "npx tsx scripts/repair-qa.ts",
    "write-meta": "npx tsx scripts/write-meta.ts",
    "build-index": "npx tsx scripts/build-index.ts",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "probe": "vitest run --config vitest.eval.config.ts scripts/dev/probe.eval.ts --disableConsoleIntercept"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "minisearch": "^7.2.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/pdf-parse": "^1.1.5",
    "happy-dom": "^20.14.5",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8"
  }
}
